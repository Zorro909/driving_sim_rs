framed = (1i != i32(0));
}

var made: u32 = pair_contacts(f, ci, push);
made_contacts = (made_contacts | select(0u, (1u << ci), (made != u32(0))));
}

continuing {
ci = (ci + 1u);
}
}
}
var r: SolveResult = solve_contacts(made_contacts, k.velocity, k.angular, k.previous_velocity, k.previous_angular);
