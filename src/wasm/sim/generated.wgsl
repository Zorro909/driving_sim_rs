}

}
case S_CORRECT_DIRECTION: {
{
if ((sim_world.path_points < u32(2i))) {
return F64(0x00000000u, 0x00000000u);
}
var tangent: vec2<f32> = normalized(curve_direction(here, err));
var forward: vec2<f32> = normalized(rotated(cached_right(), -(FRAC_PI_2_F), err));
return f64_from_f32(rclamp(dot(forward, tangent), -(bitcast<f32>(0x3f800000u)), bitcast<f32>(0x3f800000u)));
