return f64_from_f32(rclamp(fp_div(length(v2_sub(sim_car.position, vec2<f32>(wall.x, wall.y))), s.a), bitcast<f32>(0x00000000u), bitcast<f32>(0x3f800000u)));
}

}
case S_SPEED: {
