<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the new NeuralNetwork.Forward against the current MathNet version, bit for bit, and times both.
       Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- The version the game ships. -->
    <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta1" />
    <Compile Include="../changes/NeuralNetwork.Forward.cs" />
  </ItemGroup>
</Project>
