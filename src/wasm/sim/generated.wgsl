if (!(((sim_agent.flags & AGENT_HAS_PREVIOUS_OFFSET) != u32(0)))) {
var offset: F64 = closest_path(position, (0i != i32(0)), F64(0x00000000u, 0x00000000u), err).offset;
sim_agent.tracker_score = f64_add(sim_agent.tracker_score, f64_mul(select(offset, f64_sub(offset, length), f64_gt(offset, f64_div(length, F64(0x00000000u, 0x40000000u)))), f64_div(F64(0x00000000u, 0x40140000u), F64(0x00000000u, 0x40780000u))));
sim_agent.flags = select((sim_agent.flags & ~(AGENT_WENT_BACKWARDS)), (sim_agent.flags | AGENT_WENT_BACKWARDS), f64_gt(offset, f64_div(length, F64(0x00000000u, 0x40000000u))));
sim_agent.previous_offset = offset;
sim_agent.flags = (sim_agent.flags | AGENT_HAS_PREVIOUS_OFFSET);
return;
}

var previous: F64 = sim_agent.previous_offset;
var offset: F64 = closest_path(position, (1i != i32(0)), previous, err).offset;
var change: F64 = f64_sub(offset, previous);
if (f64_gt(change, f64_div(length, F64(0x00000000u, 0x40000000u)))) {
change = f64_sub(change, length);
} else {
if (f64_lt(change, f64_div(f64_neg(length), F64(0x00000000u, 0x40000000u)))) {
change = f64_add(change, length);
}
}
sim_agent.tracker_score = f64_add(sim_agent.tracker_score, f64_mul(change, f64_div(F64(0x00000000u, 0x40140000u), F64(0x00000000u, 0x40780000u))));
var crossing: F64 = f64_add(previous, change);
if (f64_lt(crossing, F64(0x00000000u, 0x00000000u))) {
sim_agent.flags = (sim_agent.flags | AGENT_WENT_BACKWARDS);
}
 else {
if (f64_ge(crossing, length)) {
if (!(((sim_agent.flags & AGENT_WENT_BACKWARDS) != u32(0)))) {
sim_agent.lap_count = u64_add(sim_agent.lap_count, U64(1u,0u));
sim_agent.lap_crossing_fraction = f64_div(f64_sub(length, previous), f64_add(f64_sub(length, previous), offset));
sim_agent.flags = (sim_agent.flags | AGENT_HAS_LAP_CROSSING);
}

sim_agent.flags = (sim_agent.flags & ~(AGENT_WENT_BACKWARDS));
}

}
sim_agent.previous_offset = offset;

}

fn stats_update(tick_arg: U64, err: ptr<function, u32>) {
var tick = tick_arg;

if (((sim_agent.flags & AGENT_PENDING_CONTACT) != u32(0))) {
sim_agent.collision_count = u64_add(sim_agent.collision_count, U64(1u,0u));
}
if (!(((sim_car.flags & CAR_ACTIVE) != u32(0)))) {
return;
}
sim_agent.update_count = u64_add(sim_agent.update_count, U64(1u,0u));
var speed: F64 = f64_from_f32(length(sim_car.velocity));
var initializing: bool = !(((sim_agent.flags & AGENT_HAS_PREVIOUS_OFFSET) != u32(0)));
score_update(sim_car.position, err);
var score: F64 = sim_agent.tracker_score;
var diff: F64 = select(f64_sub(score, sim_agent.previous_score), F64(0x00000000u, 0x00000000u), initializing);
if ((sim_agent.recent_len == u32(RECENT))) {
sim_agent.recent[sim_agent.recent_start] = diff;
sim_agent.recent_start = ((sim_agent.recent_start + u32(1i)) % u32(RECENT));
}
 else {
sim_agent.recent[((sim_agent.recent_start + sim_agent.recent_len) % u32(RECENT))] = diff;
sim_agent.recent_len = (sim_agent.recent_len + 1u);
}

var sum: F64 = F64(0x00000000u, 0x00000000u);
{
var k: u32 = u32(0i);
loop {

if (!((k < sim_agent.recent_len))) { break; }
sum = f64_add(sum, sim_agent.recent[((sim_agent.recent_start + k) % u32(RECENT))]);
continuing {
k = (k + 1u);
}
}
}
sim_agent.idle_ticks = select(i64_from_i32(0i), u64_add(sim_agent.idle_ticks, i64_from_i32(1i)), f64_lt(f64_div(sum, f64_from_u32(sim_agent.recent_len)), F64(0x9999999au, 0x3fb99999u)));
sim_agent.total_score = score;
sim_agent.previous_score = score;
sim_agent.total_speed = f64_add(sim_agent.total_speed, speed);
sim_agent.total_abs_steering = f64_add(sim_agent.total_abs_steering, f64_abs(py_clamp(sim_agent.controls[u32(1i)], f64_neg(F64(0x00000000u, 0x3ff00000u)), F64(0x00000000u, 0x3ff00000u))));
sim_agent.total_actual_distance = f64_add(sim_agent.total_actual_distance, f64_mul(speed, F64(0x9999999au, 0x3fb99999u)));
sim_agent.total_momentum_change_frequency = f64_add(sim_agent.total_momentum_change_frequency, f64_abs(f64_sub(speed, sim_agent.previous_speed)));
var throttle: F64 = py_clamp(sim_agent.controls[u32(0i)], f64_neg(F64(0x00000000u, 0x3ff00000u)), F64(0x00000000u, 0x3ff00000u));
sim_agent.total_throttle_change_frequency = f64_add(sim_agent.total_throttle_change_frequency, f64_abs(f64_sub(throttle, sim_agent.previous_throttle)));
if ((f64_gt(sim_agent.controls[u32(2i)], F64(0xeb1c432du, 0x3f1a36e2u)) || f64_gt(sim_agent.controls[u32(3i)], F64(0xeb1c432du, 0x3f1a36e2u)))) {
sim_agent.total_braking_frequency = f64_add(sim_agent.total_braking_frequency, F64(0x9999999au, 0x3fb99999u));
}
sim_agent.previous_speed = speed;
sim_agent.previous_throttle = throttle;
var wall: vec2<f32> = closest_wall_point(vec2<f32>(sim_car.position.x, sim_car.position.y));
sim_agent.total_distance_from_wall = f64_add(sim_agent.total_distance_from_wall, f64_from_f32(length(v2_sub(vec2<f32>(wall.x, wall.y), sim_car.position))));
if ((sim_world.path_points >= u32(2i))) {
var center: vec2<f32> = path_position(select(F64(0x00000000u, 0x00000000u), sim_agent.previous_offset, ((sim_agent.flags & AGENT_HAS_PREVIOUS_OFFSET) != u32(0))), err);
sim_agent.total_distance_from_center = f64_add(sim_agent.total_distance_from_center, f64_from_f32(length(v2_sub(center, sim_car.position))));
}

var right: vec2<f32> = normalized(sim_car.basis_x);
var front: f32 = dot(sim_car.velocity, rotated(right, fp_neg(bitcast<f32>(0x3fc90fdbu)), err));
var side: f32 = dot(sim_car.velocity, right);
sim_agent.current_slip_angle_degrees = f64_from_f32(fp_mul(profile_atan2(sim_world.math_profile, side, front), bitcast<f32>(0x42652ee1u)));
var slip: F64 = f64_abs(sim_agent.current_slip_angle_degrees);
sim_agent.drift_ticks = select(i64_from_i32(0i), u64_add(sim_agent.drift_ticks, i64_from_i32(1i)), ((f64_gt(speed, F64(0x00000000u, 0x40490000u)) && f64_ge(slip, F64(0x00000000u, 0x402e0000u))) && f64_le(slip, F64(0x00000000u, 0x404e0000u))));
if (u64_ge(sim_agent.drift_ticks, i64_from_i32(3i))) {
sim_agent.total_drifting_amount = f64_add(sim_agent.total_drifting_amount, F64(0x9999999au, 0x3fb99999u));
sim_agent.continuous_drift_time = f64_add(sim_agent.continuous_drift_time, F64(0x9999999au, 0x3fb99999u));
sim_agent.max_continuous_drift_time = f64_max(sim_agent.max_continuous_drift_time, sim_agent.continuous_drift_time);
}

if (u64_eq(sim_agent.drift_ticks, i64_from_i32(0i))) {
sim_agent.continuous_drift_time = F64(0x00000000u, 0x00000000u);
}
if (u64_gt(sim_agent.lap_count, sim_agent.previous_lap_count)) {
var fraction: F64 = select(F64(0x00000000u, 0x3ff00000u), sim_agent.lap_crossing_fraction, ((sim_agent.flags & AGENT_HAS_LAP_CROSSING) != u32(0)));
fraction = select(select(fraction, F64(0x00000000u, 0x3ff00000u), f64_gt(fraction, F64(0x00000000u, 0x3ff00000u))), F64(0x00000000u, 0x00000000u), f64_lt(fraction, F64(0x00000000u, 0x00000000u)));
var elapsed: F64 = f64_sub(f64_mul(f64_from_u64(u64_div_small(tick, u32(6i))), F64(0x9999999au, 0x3fb99999u)), f64_mul(f64_from_u64(u64_div_small(sim_agent.lap_start_tick, u32(6i))), F64(0x9999999au, 0x3fb99999u)));
var lap_time: F64 = f64_div(f64_rint(f64_mul(f64_add(f64_sub(elapsed, F64(0x9999999au, 0x3fb99999u)), f64_mul(fraction, F64(0x9999999au, 0x3fb99999u))), F64(0x00000000u, 0x408f4000u))), F64(0x00000000u, 0x408f4000u));
var current: F64 = select(lap_time, sim_agent.best_lap_time, ((sim_agent.flags & AGENT_HAS_BEST_LAP) != u32(0)));
sim_agent.best_lap_time = py_min(current, lap_time);
sim_agent.all_laps_time_sum = f64_add(select(F64(0x00000000u, 0x00000000u), sim_agent.all_laps_time_sum, ((sim_agent.flags & AGENT_HAS_ALL_LAPS) != u32(0))), lap_time);
sim_agent.flags = (sim_agent.flags | (AGENT_HAS_BEST_LAP | AGENT_HAS_ALL_LAPS));
sim_agent.lap_start_tick = tick;
sim_agent.previous_lap_count = sim_agent.lap_count;
}


}

fn car_deactivate() {


sim_car.flags = ((sim_car.flags & ~(CAR_ACTIVE)) | CAR_PENDING_VELOCITY);
sim_car.reset_acceleration = sim_car.acceleration;

}

fn update_stats(tick_arg: U64, stats_tick_arg: U64, eliminate_when_idle_arg: bool, err: ptr<function, u32>) {
var tick = tick_arg;
var stats_tick = stats_tick_arg;
var eliminate_when_idle = eliminate_when_idle_arg;

var was_active: bool = ((sim_car.flags & CAR_ACTIVE) != u32(0));
stats_update(stats_tick, err);
sim_agent.flags = (sim_agent.flags & ~(AGENT_PENDING_CONTACT));
if (((((sim_car.flags & CAR_ACTIVE) != u32(0)) && eliminate_when_idle) && u64_gt(sim_agent.idle_ticks, i64_from_i32(80i)))) {
car_deactivate();
}
if ((was_active && !(((sim_car.flags & CAR_ACTIVE) != u32(0))))) {
sim_agent.deactivated_at = tick;
sim_agent.flags = (sim_agent.flags | AGENT_HAS_DEACTIVATED);
}


}