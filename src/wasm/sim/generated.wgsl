var report: bool = ((r.collided && (k.was_active != u32(0))) && !(pending_velocity));
if (report) {
sim_car.collision_count = (sim_car.collision_count + 1u);
if (eliminate_on_wall) {
sim_car.flags = (sim_car.flags & ~(CAR_ACTIVE));
sim_car.reset_acceleration = sim_car.acceleration;
pending_velocity = (1i != i32(0));
}

}

if (pending_velocity) {
sim_car.velocity = vec2<f32>(bitcast<f32>(0x00000000u), bitcast<f32>(0x00000000u));
sim_car.angular_velocity = bitcast<f32>(0x00000000u);
}

sim_car.flags = (sim_car.flags & ~((CAR_PENDING_VELOCITY | CAR_RESET_RIGHT)));
sim_car.acceleration = v2_sub(sim_car.velocity, k.old_velocity);
sim_car.error = (sim_car.error | err);
return report;

}

