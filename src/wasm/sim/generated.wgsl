}
case S_VELOCITY_SIDE: {
return signed_sensor(dot(actual_velocity(), cached_right()), fp_div(sim_vehicle.max_velocity_f, bitcast<f32>(0x40000000u)));
}
case S_ACCELERATION_FRONT: {
return signed_sensor(dot(actual_acceleration(), rotated(cached_right(), -(FRAC_PI_2_F), err)), s.a);
}
case S_ACCELERATION_SIDE: {
return signed_sensor(dot(actual_acceleration(), cached_right()), s.a);
}
case S_ANGULAR_VELOCITY: {
return signed_sensor(actual_angular(), bitcast<f32>(0x40000000u));
}
case S_WHEEL_ANGLE: {
{
var i: u32 = u32(0i);
loop {

if (!((((i + u32(1i)) < sim_vehicle.wheel_count) && !((sim_vehicle.wheels[i].steering != u32(0)))))) { break; }
i = (i + 1u);
}
